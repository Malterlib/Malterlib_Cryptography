Import "../Core/Lib_Malterlib.MTarget"

%Repository "boringssl"
{
	Repository
	{
		Type "External"
		DefaultUpstreamBranch "main"
		Remotes =+ {Name: "upstream", URL: "https://github.com/google/boringssl.git"}
		{
			!!MalterlibAddUpstreams true
		}
	}
}

%Repository "libsodium"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/jedisct1/libsodium.git"}
		{
			!!MalterlibAddUpstreams true
		}
	}
}

// Only the parts of libsodium that Argon2id needs are built. Malterlib_Cryptography_KeyDerivation_Argon2id.cpp provides the missing pieces.
%Target "Lib_sodium"
{
	Target
	{
		BaseName "sodium"
		Type "StaticLibrary"
		Group "External/libsodium"
	}
	Compile
	{
		!!CompileDialect "C"
		SearchPath += "../../External/libsodium/src/libsodium/include"->MakeAbsolute()
		SearchPath += "../../External/libsodium/src/libsodium/include/sodium"->MakeAbsolute()
		Warnings "Off"
		Analyzer false
		PrefixHeader undefined

		PreprocessorDefines =+ ["CONFIGURED=1", "SODIUM_STATIC=1", "NATIVE_LITTLE_ENDIAN=1"]
		PreprocessorDefines =+ ["HAVE_TI_MODE=1", "TLS=_Thread_local", "HAVE_MLOCK=1", "HAVE_MMAP=1", "HAVE_MPROTECT=1", "HAVE_MADVISE=1"]
		{
			!PlatformFamily "Windows"
		}
		PreprocessorDefines =+ ["HAVE_POSIX_MEMALIGN=1", "HAVE_RAISE=1", "HAVE_SYSCONF=1", "HAVE_SYS_MMAN_H=1", "HAVE_SYS_PARAM_H=1", "HAVE_WEAK_SYMBOLS=1"]
		{
			!PlatformFamily "Windows"
		}
		// The compiler barrier in sodium_memzero, so link time optimization can't remove the memset
		PreprocessorDefines =+ "HAVE_INLINE_ASM=1"
		{
			!PlatformFamily "Windows"
		}
		PreprocessorDefines =+ ["_GNU_SOURCE=1", "HAVE_SYS_AUXV_H=1"]
		{
			!!PlatformFamily "Linux"
		}
		PreprocessorDefines =+ "HAVE_MEMSET_S=1"
		{
			!!PlatformFamily "macOS"
		}
		PreprocessorDefines =+ "HAVE_RAISE=1"
		{
			!!PlatformFamily "Windows"
		}
		PreprocessorDefines =+ ["HAVE_CPUID=1", "HAVE_MMINTRIN_H=1", "HAVE_EMMINTRIN_H=1", "HAVE_PMMINTRIN_H=1", "HAVE_TMMINTRIN_H=1", "HAVE_SMMINTRIN_H=1"]
		{
			!!Architecture "x64"
		}
		PreprocessorDefines =+ ["HAVE_AVXINTRIN_H=1", "HAVE_AVX2INTRIN_H=1", "HAVE_AVX512FINTRIN_H=1", "HAVE_WMMINTRIN_H=1"]
		{
			!!Architecture "x64"
		}
		PreprocessorDefines =+ ["HAVE_XGETBV_ASM=1", "HAVE_AVX_ASM=1"]
		{
			&
			{
				Architecture "x64"
				!PlatformFamily "Windows"
			}
		}
	}

	%Group "Source"
	{
		%Group "crypto_pwhash/argon2"
		{
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-core.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-encoding.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-fill-block-avx2.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-fill-block-avx512f.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-fill-block-neon.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-fill-block-ref.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2-fill-block-ssse3.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/argon2.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/blake2b-long.c"
			%File "../../External/libsodium/src/libsodium/crypto_pwhash/argon2/pwhash_argon2id.c"
		}
		%Group "crypto_generichash/blake2b"
		{
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/blake2b-compress-avx2.c"
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/blake2b-compress-ref.c"
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/blake2b-compress-sse41.c"
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/blake2b-compress-ssse3.c"
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/blake2b-ref.c"
			%File "../../External/libsodium/src/libsodium/crypto_generichash/blake2b/ref/generichash_blake2b.c"
		}
		%Group "sodium"
		{
			%File "../../External/libsodium/src/libsodium/sodium/codecs.c"
			%File "../../External/libsodium/src/libsodium/sodium/runtime.c"
			%File "../../External/libsodium/src/libsodium/sodium/utils.c"
		}
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Cryptography}/{TargetInjectionBoringSSL}"
{
	Compile
	{
		&
		{
			LanguageFamily "Native"
			CompileDialect "C"
		}

		SearchPath += "../../External/boringssl/include"->MakeAbsolute()
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Cryptography}/{DependOnBoringSSL}"
{
	%Dependency "Lib_BoringSSL_crypto"
	{
		&
		{
			!DocumentationEnabled true
			!Target.Type "Tool"
		}
		Dependency.Indirect !TargetIsExecutable
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_ssl"
	{
		&
		{
			!DocumentationEnabled true
			!Target.Type "Tool"
		}
		Dependency.Indirect !TargetIsExecutable
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_decrepit"
	{
		&
		{
			!DocumentationEnabled true
			!Target.Type "Tool"
		}
		Dependency.Indirect !TargetIsExecutable
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_fipsmodule"
	{
		&
		{
			!DocumentationEnabled true
			!Target.Type "Tool"
		}
		Dependency.Indirect !TargetIsExecutable
		Dependency.LinkWithObjectFiles false
	}
}

%Import "../../External/boringssl/CMakeLists.txt"
{
	Import.CMake_Variables =+ "CMAKE_BUILD_WITH_INSTALL_RPATH=ON"
	{
		&
		{
			PlatformFamily "Linux"
		}
	}
	Import.CMake_Variables =+ "OPENSSL_NO_ASM=ON"
	{
		&
		{
			PlatformFamily "Windows"
			HostPlatformFamily "Windows"
			Architecture "arm64"
		}
	}

	Import.CMake_FullRebuildVersion `@(Import.CMake_FullRebuildVersion).21`
	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 2
		TabWidth 2
		UsesTabs false

		PreprocessorDefines += "OPENSSL_ALLOW_MALFORMED_X509_VERSION"
		{
			!!CompileDialect "C"
		}
	}
	Compile
	{
		!!Compile.Type "AssemblerNasm"
		ExtraCompilerFlags =+ "-gcv8"
		{
			!!PlatformFamily "Windows"
		}
	}
	Compile.Type "AssemblerNasm"
	{
		&
		{
			|
			{
				!this.Type "File"
				!File:this.Identity ~"*.S"
			}
			Compile.Type "Assembler"
		}
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined

		// The prefix header must precede BoringSSL's Malterlib locks because Core overrides global operator new.
		PrefixHeader "../Core/Source/PrefixHeader/PCH.h"->MakeAbsolute()
		{
			!!Compile.Type "C++"
		}

		Analyzer false

		PreprocessorDefines =+ "OPENSSL_C11_ATOMIC=1"
		{
			!PlatformFamily "Windows"
		}

		ExtraCompilerFlags =+ [
			"-wd4100"
			, "-wd4127"
			, "-wd4200"
			, "-wd4204"
			, "-wd4221"
			, "-wd4242"
			, "-wd4244"
			, "-wd4245"
			, "-wd4267"
			, "-wd4371"
			, "-wd4388"
			, "-wd4296"
			, "-wd4350"
			, "-wd4365"
			, "-wd4389"
			, "-wd4464"
			, "-wd4510"
			, "-wd4512"
			, "-wd4514"
			, "-wd4548"
			, "-wd4610"
			, "-wd4623"
			, "-wd4625"
			, "-wd4626"
			, "-wd4706"
			, "-wd4710"
			, "-wd4711"
			, "-wd4800"
			, "-wd4820"
			, "-wd5027"
			, "-w44265"
		]
		{
			&
			{
				PlatformType "Windows"
				!Target.VisualStudioPlatform "Clang"
				!Target.PlatformToolset "ClangCL"
			}
		}

		ExtraCompilerFlags += "/std:c11"
		{
			&
			{
				Compile.Type "C"
				PlatformType "Windows"
				!Target.VisualStudioPlatform "Clang"
				!Target.PlatformToolset "ClangCL"
			}
		}

		Warnings_UnusedFunction false
		{
			!!Compiler "Clang"
		}
	}
	%Target "Lib_BoringSSL_crypto"
	{
		Property.MalterlibGenerateLibrary true // Needed because for asm objects are not included otherwise

		Target
		{
			LinkerGroup "BoringSSL"
			DependencyInjectionGroups =+ "{Malterlib}/{Lib_Malterlib_Cryptography}/{TargetInjectionBoringSSL}"
		}

		%Dependency "Security"
		{
			!!PlatformIsDarwin true

			Dependency
			{
				Type "Framework"
				Indirect true
			}
		}
	}
	%Target "Lib_BoringSSL_decrepit"
	{
		Target.LinkerGroup "BoringSSL"
		%Dependency "Lib_BoringSSL_crypto"
		{
			Dependency
			{
				Indirect true
				LinkWithObjectFiles false
			}
		}
	}
	%Target "Lib_BoringSSL_ssl"
	{
		Target.LinkerGroup "BoringSSL"
		%Dependency "Lib_BoringSSL_crypto"
		{
			Dependency
			{
				Indirect true
				LinkWithObjectFiles false
			}
		}
	}
}

Import
{
	CMake_Variables =+ [
		`OPENSSL_ROOT_DIR=@("../../External/boringssl"->MakeAbsolute())`
		, `OPENSSL_INCLUDE_DIR=@("../../External/boringssl/include"->MakeAbsolute())`
		, `OPENSSL_LIBRARIES=@(Malterlib_DummmyLibrary)`
		, `OPENSSL_CRYPTO_LIBRARY=@(Malterlib_DummmyLibrary)`
		, `OPENSSL_CRYPTO_LIBRARIES=@(Malterlib_DummmyLibrary)`
		, `OPENSSL_SSL_LIBRARY=@(Malterlib_DummmyLibrary)`
		, `OPENSSL_SSL_LIBRARIES=@(Malterlib_DummmyLibrary)`
		, "OPENSSL_USE_STATIC_LIBS=TRUE"
		, "OPENSSL_MSVC_STATIC_RT=TRUE"
		, "OPENSSL_FOUND=TRUE"
		, "OpenSSL_FOUND=TRUE"
		, "DISABLE_OPENSSL_WINDOWS=TRUE"
	]
}

%Group "{Malterlib}/{Lib_Malterlib_Cryptography}"
{
	%Group "Cryptography"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Cryptography/^*"
		}
		%File "Source/*"
		%File "Source/Malterlib_Cryptography_BoringSSL_Windows_x64.asm"
		{
			Compile.Disabled true
			{
				!Architecture "x64"
				!PlatformFamily "Windows"
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}

	%Dependency "Lib_BoringSSL_crypto"
	{
		&
		{
			!DocumentationEnabled true
		}
		Dependency.Indirect true
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_ssl"
	{
		&
		{
			!DocumentationEnabled true
		}
		Dependency.Indirect true
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_decrepit"
	{
		&
		{
			!DocumentationEnabled true
		}
		Dependency.Indirect true
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_BoringSSL_fipsmodule"
	{
		&
		{
			!DocumentationEnabled true
		}
		Dependency.Indirect true
		Dependency.LinkWithObjectFiles false
	}
	%Dependency "Lib_sodium"
	{
		!DocumentationEnabled true

		Dependency.Indirect true
	}
}

Property
{
	MalterlibLibrary_Cryptography: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Cryptography"
	{
		!!MalterlibLibrary_Cryptography true
	}
	MalterlibLibrarySeparate_Lib_Malterlib_Cryptography: bool = true
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Cryptography: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Cryptography true
	}
}

%Group "{Test}/{Malterlib_Cryptography}"
{
}

Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests =+ "Malterlib_Cryptography"
	MalterlibTestFiles_Malterlib_Cryptography: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestExtraGroups_Malterlib_Cryptography: [string] = ["{Test}/{Malterlib_Cryptography}"]
}
